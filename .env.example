# Copie este arquivo para `.env` na raiz do repositório:
#   copy .env.example .env   (Windows)   |   cp .env.example .env   (Unix)
# O Docker Compose lê `.env` automaticamente para preencher as variáveis abaixo no serviço MySQL.

# Senha do usuário root do MySQL (somente dentro do container).
MYSQL_ROOT_PASSWORD=defina_uma_senha_forte_root

# Banco e usuário da aplicação (criados automaticamente pela imagem oficial).
MYSQL_DATABASE=conos
MYSQL_USER=conos
MYSQL_PASSWORD=defina_uma_senha_para_o_app

# --- Backend (npm run dev na pasta backend) ---
# Use os MESMOS database, usuário e senha nas variáveis DB_*:
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_NAME=conos
#   DB_USER=conos
#   DB_PASSWORD=<mesmo valor de MYSQL_PASSWORD>
#   JWT_SECRET=<uma chave longa e aleatória>
