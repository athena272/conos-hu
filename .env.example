# Copie este arquivo para `.env` na raiz do repositório:
#   copy .env.example .env   (Windows)   |   cp .env.example .env   (Unix)
# O Docker Compose lê `.env` automaticamente para o serviço MongoDB.

# Usuário root do MongoDB (criado na primeira inicialização do container).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=defina_uma_senha_forte

# --- Backend (copie também para backend/.env ou exporte no shell) ---
# Use a mesma senha de MONGO_ROOT_PASSWORD na URI:
#   MONGODB_URI=mongodb://root:<MONGO_ROOT_PASSWORD>@127.0.0.1:27017/conos?authSource=admin
#   JWT_SECRET=<valor aleatório — ver README "Gerar JWT_SECRET" (PowerShell ou openssl)>
