{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "./app.ts",
    "./api/**/*.ts",
    "./server/**/*.ts",
    "./controllers/**/*.ts",
    "./routes/**/*.ts",
    "./models/**/*.ts",
    "./middleware/**/*.ts",
    "./services/**/*.ts",
    "./types/**/*.ts",
    "./test-db-connection.ts",
    "./scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
