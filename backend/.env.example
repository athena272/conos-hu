# Copie para backend/.env (usado por testes; para npm run dev exporte no shell ou use seu IDE).
# Suba o MongoDB antes: na raiz do repo, docker compose up -d

# Se a senha tiver / + @ etc., codifique só a senha (PowerShell: [uri]::EscapeDataString("sua_senha"))
MONGODB_URI=mongodb://root:defina_uma_senha_forte@127.0.0.1:27017/conos?authSource=admin&replicaSet=rs0
# Gere com PowerShell (README "Gerar JWT_SECRET") e cole abaixo:
#   $bytes = New-Object byte[] 48
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
JWT_SECRET=defina_uma_chave_longa_e_aleatoria
PORT=3001
